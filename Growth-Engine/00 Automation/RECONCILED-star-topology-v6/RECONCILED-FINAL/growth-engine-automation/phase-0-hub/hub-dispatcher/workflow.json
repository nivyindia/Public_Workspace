        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "INSERT INTO flagged_events (funnel_event_id, event_type, client_id, payload, flagged_at)\nVALUES ({{$json.id}}, {{JSON.stringify($json.event_type)}}, {{$json.client_id ?? null}}, {{JSON.stringify($json.payload || {})}}::jsonb, now());",
                "options": {}
            },
