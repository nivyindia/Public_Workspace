{
    "name": "6.6 - NPS Survey + Detractor/Promoter Routing",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "0 9 1 */3 *"
                        }
                    ]
                }
            },
            "id": "n1-quarterly-trigger",
            "name": "Quarterly 9AM (1st of Qtr)",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                200,
                260
            ],
            "notes": "\u26a0\ufe0f ASSUMED cadence = quarterly. KB (Stage 51) leaves monthly-vs-quarterly undecided -- change cron here once Nivy confirms."
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "SELECT * FROM clients_master WHERE status IN ('Onboarded', 'Active') AND (last_nps_sent_at IS NULL OR last_nps_sent_at < now() - interval '80 days');",
                "options": {}
            },
            "id": "n2-fetch-active-clients",
            "name": "Fetch Active Clients Due for Survey",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.5,
            "position": [
                420,
                260
            ],
            "credentials": {
                "postgres": {
                    "id": "REPLACE_WITH_CREDENTIAL_ID",
                    "name": "Odoo Postgres"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const token = Buffer.from(`${$json.id}.${Date.now()}`).toString('base64url');\nreturn [{ json: { ...$json, nps_survey_token: token, nps_survey_url: `${$env.NPS_SURVEY_BASE_URL}/webhook/nps-response?t=${token}` } }];"
            },
            "id": "n3-build-survey-link",
            "name": "Build Survey Link",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                640,
                260
            ]
        },
        {
            "parameters": {
                "fromEmail": "={{$env.OUTREACH_FROM_EMAIL}}",
                "toEmail": "={{$json.email}}",
                "subject": "Quick question -- how are we doing?",
                "emailFormat": "text",
                "text": "={{`Hi ${$json.name}, on a scale of 0-10, how likely are you to recommend Nivy to a colleague? Reply here: ${$json.nps_survey_url}`}}",
                "options": {}
            },
            "id": "n4-send-nps-email",
            "name": "Send NPS Survey Email (Postal SMTP)",
            "type": "n8n-nodes-base.emailSend",
            "typeVersion": 2.1,
            "position": [
                860,
                260
            ],
            "credentials": {
                "smtp": {
                    "id": "REPLACE_WITH_CREDENTIAL_ID",
                    "name": "Postal SMTP"
                }
            }
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "UPDATE clients_master SET last_nps_sent_at = now() WHERE id = {{$json.id}};",
                "options": {}
            },
            "id": "n5-mark-sent",
            "name": "Postgres - Mark Survey Sent",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.5,
            "position": [
                1080,
                260
            ],
            "credentials": {
                "postgres": {
                    "id": "REPLACE_WITH_CREDENTIAL_ID",
                    "name": "Odoo Postgres"
                }
            }
        },
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "nps-response",
                "responseMode": "responseNode",
                "options": {}
            },
            "id": "n6-nps-response-webhook",
            "name": "NPS Response Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [
                200,
                460
            ],
            "notes": "Survey tool (Typeform/self-hosted form) posts here: { token, score (0-10), feedback_text }"
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "INSERT INTO nps_responses (client_id, score, feedback_text, submitted_at)\nSELECT id, {{$json.body.score}}, {{JSON.stringify($json.body.feedback_text || '')}}, now()\nFROM clients_master WHERE id = (SELECT client_id FROM nps_survey_tokens WHERE token = '{{$json.body.token}}')\nRETURNING *, (SELECT odoo_lead_id FROM clients_master WHERE id = nps_responses.client_id) AS odoo_lead_id;",
                "options": {}
            },
            "id": "n7-insert-nps-response",
            "name": "Postgres - Insert NPS Response",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.5,
            "position": [
                420,
                460
            ],
            "credentials": {
                "postgres": {
                    "id": "REPLACE_WITH_CREDENTIAL_ID",
                    "name": "Odoo Postgres"
                }
            },
            "notes": "Assumes a nps_survey_tokens lookup table mapping token->client_id (simpler alternative: decode client id directly from the base64url token built in n3, skipping the lookup table -- pick whichever matches your actual survey-tool integration). | S6-gap-fill: added odoo_lead_id via correlated scalar subquery in RETURNING so 'Report to Hub' downstream (promoter branch) doesn't need a second DB round-trip."
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "loose"
                    },
                    "conditions": [
                        {
                            "leftValue": "={{$json.score}}",
                            "rightValue": 6,
                            "operator": {
                                "type": "number",
                                "operation": "lte"
                            }
                        }
                    ],
                    "combinator": "and"
                },
                "options": {}
            },
            "id": "n8-if-detractor",
            "name": "IF - Detractor (0-6)?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.2,
            "position": [
                640,
                460
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{$env.ODOO_URL}}/jsonrpc",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"jsonrpc\": \"2.0\", \"method\": \"call\",\n  \"params\": {\n    \"service\": \"object\", \"method\": \"execute_kw\",\n    \"args\": [\"{{$env.ODOO_DB}}\", {{$env.ODOO_UID}}, \"{{$env.ODOO_API_KEY}}\",\n      \"mail.channel\", \"message_post\",\n      [ [{{$env.ODOO_DISCUSS_CHANNEL_ID}}], {\n        \"body\": {{JSON.stringify('DETRACTOR NPS: ' + ($json.name||'') + ' scored ' + $json.score + '/10 -- human follow-up needed. Feedback: ' + ($json.feedback_text||'none'))}}\n      } ]\n  }, \"id\": 1\n}",
                "options": {
                    "response": {
                        "response": {
                            "neverError": true
                        }
                    }
                }
            },
            "id": "n9-discuss-detractor-alert",
            "name": "Odoo Discuss - Detractor Alert",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                860,
                380
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "loose"
                    },
                    "conditions": [
                        {
                            "leftValue": "={{$json.score}}",
                            "rightValue": 9,
                            "operator": {
                                "type": "number",
                                "operation": "gte"
                            }
                        }
                    ],
                    "combinator": "and"
                },
                "options": {}
            },
            "id": "n10-if-promoter",
            "name": "IF - Promoter (9-10)?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.2,
            "position": [
                860,
                540
            ]
        },
        {
            "parameters": {
                "operation": "executeQuery",
                "query": "UPDATE clients_master SET promoter_flag = true, promoter_flagged_at = now() WHERE id = {{$json.client_id}};",
                "options": {}
            },
            "id": "n11-mark-promoter",
            "name": "Postgres - Flag Promoter (feeds Stage 52/53)",
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.5,
            "position": [
                1080,
                540
            ],
            "credentials": {
                "postgres": {
                    "id": "REPLACE_WITH_CREDENTIAL_ID",
                    "name": "Odoo Postgres"
                }
            },
            "notes": "Module 6.7 (Case Studies) and 6.8 (Referral) both poll on promoter_flag = true."
        },
        {
            "parameters": {
                "respondWith": "text",
                "responseBody": "Thanks for your feedback!",
                "options": {}
            },
            "id": "n12-respond-ok",
            "name": "Respond 200 OK",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1.1,
            "position": [
                1300,
                460
            ]
        },
        {
            "parameters": {
                "workflowId": "REPLACE_WITH_0.0_HUB_INTAKE_WORKFLOW_ID",
                "workflowInputs": {
                    "value": {
                        "event_type": "nps.promoter_flagged",
                        "client_id": "={{$('Postgres - Insert NPS Response').item.json.client_id}}",
                        "odoo_lead_id": "={{$('Postgres - Insert NPS Response').item.json.odoo_lead_id}}",
                        "source_module": "6.6",
                        "payload": "={{ { score: $('Postgres - Insert NPS Response').item.json.score, feedback_text: $('Postgres - Insert NPS Response').item.json.feedback_text, submitted_at: $('Postgres - Insert NPS Response').item.json.submitted_at } }}"
                    }
                },
                "options": {}
            },
            "id": "report-to-hub-6-6",
            "name": "Report to Hub",
            "type": "n8n-nodes-base.executeWorkflow",
            "typeVersion": 1.2,
            "position": [
                1300,
                620
            ],
            "notes": "S6-gap-fill \u2014 sirf promoter branch se fire hota hai (IF - Promoter (9-10)? ke true side), 'Postgres - Flag Promoter' ke parallel me 'Respond 200 OK' ko block kiye bina. event_type: nps.promoter_flagged, per S0-EVENT-TYPE-TAXONOMY.md (6.6 row, consumed by 6.7 Case Studies aur 6.8 Referral Program). Detractor branch koi Hub event nahi bhejta -- taxonomy me sirf promoter-flag wired hai, detractor sirf internal Discuss alert tak hi limited hai (as designed)."
        }
    ],
    "connections": {
        "Quarterly 9AM (1st of Qtr)": {
            "main": [
                [
                    {
                        "node": "Fetch Active Clients Due for Survey",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Fetch Active Clients Due for Survey": {
            "main": [
                [
                    {
                        "node": "Build Survey Link",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Build Survey Link": {
            "main": [
                [
                    {
                        "node": "Send NPS Survey Email (Postal SMTP)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Send NPS Survey Email (Postal SMTP)": {
            "main": [
                [
                    {
                        "node": "Postgres - Mark Survey Sent",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "NPS Response Webhook": {
            "main": [
                [
                    {
                        "node": "Postgres - Insert NPS Response",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Postgres - Insert NPS Response": {
            "main": [
                [
                    {
                        "node": "IF - Detractor (0-6)?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "IF - Detractor (0-6)?": {
            "main": [
                [
                    {
                        "node": "Odoo Discuss - Detractor Alert",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "IF - Promoter (9-10)?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Odoo Discuss - Detractor Alert": {
            "main": [
                [
                    {
                        "node": "Respond 200 OK",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "IF - Promoter (9-10)?": {
            "main": [
                [
                    {
                        "node": "Postgres - Flag Promoter (feeds Stage 52/53)",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Respond 200 OK",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Postgres - Flag Promoter (feeds Stage 52/53)": {
            "main": [
                [
                    {
                        "node": "Respond 200 OK",
                        "type": "main",
                        "index": 0
                    },
                    {
                        "node": "Report to Hub",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    }
}