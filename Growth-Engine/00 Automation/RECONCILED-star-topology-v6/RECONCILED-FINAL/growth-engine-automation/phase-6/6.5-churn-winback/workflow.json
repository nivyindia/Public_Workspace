{
  "name": "6.5 - Churn Win-back + Escalation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "n1-daily-trigger",
      "name": "Daily 8AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "event_type"
            },
            {
              "name": "client_id"
            },
            {
              "name": "payload"
            }
          ]
        }
      },
      "id": "n12-hub-trigger",
      "name": "Triggered by Hub (renewal.overdue)",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        460
      ],
      "notes": "Star topology S6.6: Hub-Dispatcher calls this instead of 6.5 polling independently. Fires on event_type = 'renewal.overdue' (per S4.7's renewal.due -> S6.6 references this as renewal.overdue; flagged in README, confirm exact event_type with S4.7 before wiring Dispatcher's Switch). Feeds the SAME fetch query as Daily 8AM -- kept because the 7/14/21-day cadence still needs to know 'which step is due next' for whichever clients are due today, not just the one client named in the triggering event. Daily 8AM is kept as a safety-net poll; do not delete it (see README)."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT *,\n  CASE\n    WHEN winback_step IS NULL OR winback_step = 0 THEN 1\n    WHEN winback_step = 1 AND last_winback_sent_at < now() - interval '7 days' THEN 2\n    WHEN winback_step = 2 AND last_winback_sent_at < now() - interval '7 days' THEN 3\n    WHEN winback_step = 3 AND last_winback_sent_at < now() - interval '7 days' THEN 4\n    ELSE 0\n  END AS next_step\nFROM clients_master\nWHERE status = 'Churn Risk'\nHAVING (CASE\n    WHEN winback_step IS NULL OR winback_step = 0 THEN 1\n    WHEN winback_step = 1 AND last_winback_sent_at < now() - interval '7 days' THEN 2\n    WHEN winback_step = 2 AND last_winback_sent_at < now() - interval '7 days' THEN 3\n    WHEN winback_step = 3 AND last_winback_sent_at < now() - interval '7 days' THEN 4\n    ELSE 0\n  END) > 0;",
        "options": {}
      },
      "id": "n2-fetch-due-winback",
      "name": "Fetch Churn-Risk Clients Due for Next Touch",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        420,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Odoo Postgres"
        }
      },
      "notes": "\u26a0\ufe0f ASSUMED cadence (not in KB, needs Nivy sign-off): Day 0 email -> Day 7 WhatsApp -> Day 14 email -> Day 21 founder escalation. Change the interval literals here if the real policy differs."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.next_step}}",
                    "rightValue": 1,
                    "operator": {
                      "type": "number",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "outputKey": "step1_email"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.next_step}}",
                    "rightValue": 2,
                    "operator": {
                      "type": "number",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "outputKey": "step2_whatsapp"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.next_step}}",
                    "rightValue": 3,
                    "operator": {
                      "type": "number",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "outputKey": "step3_email"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.next_step}}",
                    "rightValue": 4,
                    "operator": {
                      "type": "number",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "outputKey": "step4_escalate"
            }
          ]
        },
        "options": {}
      },
      "id": "n3-switch-step",
      "name": "Switch - Win-back Step",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"qwen2.5:7b\",\n  \"stream\": false,\n  \"prompt\": \"Draft a short, warm, non-desperate win-back email for a client who has gone quiet (Nivy International digital agency). Step: {{$json.next_step}} of 3. Client name: {{$json.name}}, service: {{$json.service_type}}. Return ONLY JSON with keys: subject, body (plain text, under 120 words).\"\n}"
      },
      "id": "n4-ollama-draft-email",
      "name": "Ollama - Draft Win-back Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.response;\nlet parsed;\ntry { parsed = JSON.parse(raw); } catch(e) { parsed = { subject: 'We miss working with you', body: raw }; }\nreturn [{ json: { ...$('Switch - Win-back Step').item.json, email_subject: parsed.subject, email_body: parsed.body } }];"
      },
      "id": "n5-parse-email-draft",
      "name": "Parse Email Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        160
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{$env.OUTREACH_FROM_EMAIL}}",
        "toEmail": "={{$json.email}}",
        "subject": "={{$json.email_subject}}",
        "emailFormat": "text",
        "text": "={{$json.email_body}}",
        "options": {}
      },
      "id": "n6-send-winback-email",
      "name": "Send Win-back Email (Postal SMTP)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1300,
        160
      ],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Postal SMTP"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"qwen2.5:7b\",\n  \"stream\": false,\n  \"prompt\": \"Draft a short, casual WhatsApp win-back message (under 40 words) for a quiet client of Nivy International. Client name: {{$json.name}}. Return ONLY JSON with key: message.\"\n}"
      },
      "id": "n7-ollama-draft-whatsapp",
      "name": "Ollama - Draft Win-back WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.response;\nlet parsed;\ntry { parsed = JSON.parse(raw); } catch(e) { parsed = { message: raw }; }\nreturn [{ json: { ...$('Switch - Win-back Step').item.json, whatsapp_message: parsed.message } }];"
      },
      "id": "n8-parse-whatsapp-draft",
      "name": "Parse WhatsApp Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.WAHA_URL}}/api/sendText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Api-Key",
              "value": "={{$env.WAHA_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"session\": \"{{$env.WAHA_SESSION}}\",\n  \"chatId\": \"{{$json.phone.replace(/[^0-9]/g, '')}}@c.us\",\n  \"text\": {{JSON.stringify($json.whatsapp_message)}}\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "n9-send-winback-whatsapp",
      "name": "Send Win-back WhatsApp (Waha)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.ODOO_URL}}/jsonrpc",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\", \"method\": \"call\",\n  \"params\": {\n    \"service\": \"object\", \"method\": \"execute_kw\",\n    \"args\": [\"{{$env.ODOO_DB}}\", {{$env.ODOO_UID}}, \"{{$env.ODOO_API_KEY}}\",\n      \"mail.channel\", \"message_post\",\n      [ [{{$env.ODOO_DISCUSS_CHANNEL_ID}}], {\n        \"body\": {{JSON.stringify('WIN-BACK ESCALATION: No response after 3 touches from ' + $json.name + ' (' + $json.company + '). Founder call needed -- client did not re-engage via email/WhatsApp win-back sequence.')}}\n      } ]\n  }, \"id\": 1\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "n10-discuss-escalation-alert",
      "name": "Odoo Discuss - Founder Escalation Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        440
      ],
      "notes": "Step 4 (Day 21): no client-facing message, direct founder escalation per \u00a76.5.2 spec."
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "REPLACE_WITH_HUB_INTAKE_WORKFLOW_ID",
          "mode": "id"
        },
        "workflowInputs": {
          "value": {
            "event_type": "winback.escalated",
            "source_module": "6.5",
            "client_id": "={{$json.id}}",
            "payload": "={{ { name: $json.name, company: $json.company, email: $json.email, winback_step: $json.next_step, escalated_at: $now.toISO() } }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "mode": "each",
        "options": {}
      },
      "id": "n13-report-to-hub-escalation",
      "name": "Report to Hub - Winback Escalated",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1080,
        440
      ],
      "notes": "S6.6: only the day-21 escalation step reports to the Hub, per plan -- gives founder escalation its own alert path (e.g. downstream 'flag for review' or dashboard). Steps 1-3 (email/WhatsApp touches) do NOT report to Hub. Calls the Hub-Intake sub-workflow (see plan \u00a70.2) -- set REPLACE_WITH_HUB_INTAKE_WORKFLOW_ID once Hub-Intake exists (see README gap note)."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE clients_master SET winback_step = {{$json.next_step}}, last_winback_sent_at = now() WHERE id = {{$json.id}};",
        "options": {}
      },
      "id": "n11-mark-step-sent",
      "name": "Postgres - Mark Win-back Step Sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1520,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Odoo Postgres"
        }
      }
    }
  ],
  "connections": {
    "Daily 8AM": {
      "main": [
        [
          {
            "node": "Fetch Churn-Risk Clients Due for Next Touch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Triggered by Hub (renewal.overdue)": {
      "main": [
        [
          {
            "node": "Fetch Churn-Risk Clients Due for Next Touch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Churn-Risk Clients Due for Next Touch": {
      "main": [
        [
          {
            "node": "Switch - Win-back Step",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Switch - Win-back Step": {
      "main": [
        [
          {
            "node": "Ollama - Draft Win-back Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ollama - Draft Win-back WhatsApp",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ollama - Draft Win-back Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Odoo Discuss - Founder Escalation Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama - Draft Win-back Email": {
      "main": [
        [
          {
            "node": "Parse Email Draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Email Draft": {
      "main": [
        [
          {
            "node": "Send Win-back Email (Postal SMTP)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Win-back Email (Postal SMTP)": {
      "main": [
        [
          {
            "node": "Postgres - Mark Win-back Step Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama - Draft Win-back WhatsApp": {
      "main": [
        [
          {
            "node": "Parse WhatsApp Draft",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse WhatsApp Draft": {
      "main": [
        [
          {
            "node": "Send Win-back WhatsApp (Waha)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Win-back WhatsApp (Waha)": {
      "main": [
        [
          {
            "node": "Postgres - Mark Win-back Step Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Odoo Discuss - Founder Escalation Alert": {
      "main": [
        [
          {
            "node": "Report to Hub - Winback Escalated",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Report to Hub - Winback Escalated": {
      "main": [
        [
          {
            "node": "Postgres - Mark Win-back Step Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}