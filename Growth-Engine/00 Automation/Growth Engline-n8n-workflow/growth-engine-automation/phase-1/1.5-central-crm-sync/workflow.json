    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Odoo CRM stage change detect: compare crm.lead.stage_id (Odoo) against last-known stage in clients_master\nSELECT\n  cl.id AS odoo_lead_id,\n  cl.name,\n  cl.email_from AS email,\n  cl.phone,\n  cl.partner_name AS company,\n  st.name AS current_stage,\n  cm.status AS last_known_status\nFROM crm_lead cl\nJOIN crm_stage st ON st.id = cl.stage_id\nLEFT JOIN clients_master cm ON cm.odoo_lead_id = cl.id\nWHERE cm.odoo_lead_id IS NULL\n   OR st.name != cm.status\nORDER BY cl.write_date DESC\nLIMIT 25;",
        "options": {}
      },
      "id": "n2-detect-changes",
      "name": "Detect CRM Stage Changes",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        400,
        320
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Odoo Postgres"
        }
      },
      "notes": "crm_lead aur crm_stage Odoo ke actual Postgres tables hain (same DB). st.name Odoo me aapke pipeline stages ke exact naam se match hone chahiye: New, Qualified, Contacted, Nurtured, Booked, Proposal Sent, Won, Onboarded, Delivered, Renewal - Section 1 wale funnel status ke mutabiq CRM pipeline stages rename kar lena."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO clients_master (odoo_lead_id, name, email, phone, company, status, created_at, updated_at)\nVALUES ({{$json.odoo_lead_id}}, {{JSON.stringify($json.name)}}, {{JSON.stringify($json.email)}}, {{JSON.stringify($json.phone)}}, {{JSON.stringify($json.company)}}, {{JSON.stringify($json.current_stage)}}, now(), now())\nON CONFLICT (odoo_lead_id) DO UPDATE\nSET status = EXCLUDED.status, updated_at = now();",
        "options": {}
      },
      "id": "n3-upsert-master",
      "name": "Upsert clients_master",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        620,
        320
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Odoo Postgres"
        }
      },
      "notes": "Ye woh 'single source of truth sync' hai jiska zikr Master Plan ke Section 5.1 me hai - har module isi table ko read/write karta hai."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
