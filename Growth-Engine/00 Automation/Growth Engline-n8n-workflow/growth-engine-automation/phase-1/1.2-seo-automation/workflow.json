          }
        ]
      ]
    },
    "Fetch Sitemap XML": {
      "main": [
        [
          {
            "node": "Extract URLs from Sitemap",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract URLs from Sitemap": {
      "main": [
        [
          {
            "node": "Loop URLs (batch 10)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop URLs (batch 10)": {
      "main": [
        [
          {
            "node": "Build Weekly SEO Report",
            "type": "main",
