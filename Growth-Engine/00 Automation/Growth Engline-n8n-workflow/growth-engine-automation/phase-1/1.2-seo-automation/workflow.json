            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Loop URLs (batch 10)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect Broken Link": {
      "main": [
        [
          {
