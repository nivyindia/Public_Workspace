        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"service\": \"object\",\n    \"method\": \"execute_kw\",\n    \"args\": [\n      \"{{$env.ODOO_DB}}\",\n      {{$env.ODOO_UID}},\n      \"{{$env.ODOO_API_KEY}}\",\n      \"crm.lead\",\n      \"write\",\n      [ [{{$json.odoo_lead_id}}], { \"stage_id\": {{$env.ODOO_WON_STAGE_ID}} } ]\n    ]\n  },\n  \"id\": 1\n}"
      },
      "id": "n11-odoo-mark-won",
      "name": "Odoo - Set CRM Stage to Won",
