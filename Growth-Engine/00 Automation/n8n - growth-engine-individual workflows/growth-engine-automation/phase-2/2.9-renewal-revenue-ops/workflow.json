          }
        ]
      ]
    },
    "Postgres - Mark Renewal Reminder Sent": {
      "main": [
        [
          {
            "node": "Odoo Discuss - Renewal Reminder Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Overdue (Past Renewal Date)": {
      "main": [
        [
          {
            "node": "Postgres - Mark Churn Risk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres - Mark Churn Risk": {
      "main": [
        [
          {
            "node": "Odoo Discuss - Churn Risk Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Failed Payment Webhook": {
      "main": [
        [
          {
