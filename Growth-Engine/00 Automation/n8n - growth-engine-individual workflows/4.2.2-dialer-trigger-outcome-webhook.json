        "jsCode": "// 4.2.2.3: outcome-payload parse\nconst body = $json;\nreturn [{ json: {\n  lead_id: body.lead_id || body.vendor_lead_code,\n  outcome: body.status || body.disposition || 'unknown', // e.g. SALE, NI (not interested), DNC, CALLBK, N/A\n  call_duration_sec: body.call_length || null,\n  agent: body.user || null,\n  event_id: body.uniqueid || body.call_id\n} }];"
      },
