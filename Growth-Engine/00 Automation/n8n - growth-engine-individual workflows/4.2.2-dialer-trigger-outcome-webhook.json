    {
      "parameters": {
        "httpMethod": "POST",
        "path": "call-outcome",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "n10-outcome-webhook",
      "name": "Call Outcome Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        560
      ],
      "webhookId": "call-outcome",
      "notes": "VICIdial ka post-call 'URL Load Webform' / disposition-script feature isi URL ko call-outcome data ke saath POST karega (VICIdial admin -> Campaign -> Web Form Integration mein configure karna hoga — ⚠️ INPUT NEEDED)."
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst body = $input.item.json.body || {};\nconst receivedSecret = $input.item.json.headers['x-webhook-secret'] || $input.item.json.query.secret || '';\nlet valid = false;\ntry { valid = crypto.timingSafeEqual(Buffer.from(receivedSecret), Buffer.from($env.CALL_OUTCOME_WEBHOOK_SECRET)); } catch (e) { valid = false; }\nreturn [{ json: { ...body, sig_valid: valid } }];"
      },
      "id": "n11-verify-secret",
      "name": "Verify Shared Secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        560
      ],
      "notes": "§16.2 standard: VICIdial ka webform-post native HMAC support nahi karta, isliye shared-secret (CALL_OUTCOME_WEBHOOK_SECRET) query-param/header approach use kiya — VICIdial ke Web Form Integration URL mein ?secret=... append karo."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-secret-valid",
              "leftValue": "={{$json.sig_valid}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
