  "node": {
    "name": "3.1.5.6 - Merge Four Lead Sources",
    "type": "n8n-nodes-base.merge"
  },

  "inputs": [
    {
      "source": "3.1.1",
      "label": "google_maps"
    },
    {
      "source": "3.1.2",
      "label": "linkedin_hiring_post"
    },
    {
      "source": "3.1.3",
      "label": "digital_footprints"
    },
    {
      "source": "3.1.4",
      "label": "lead_generation_agent"
    }
  ],

  "output_schema": {
    "fields": [
      "name",
      "phone",
      "email",
      "website",
      "source"
    ]
  },

  "rules": [
    "Merge normalized outputs only.",
    "Do not deduplicate here.",
    "Do not enrich here.",
    "Do not modify source attribution.",
    "Every lead retains its originating source."
  ],

  "integration": {
