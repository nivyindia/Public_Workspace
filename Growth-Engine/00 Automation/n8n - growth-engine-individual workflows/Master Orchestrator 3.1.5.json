{
  "plan_id": "3.1.5.1",
  "parent_workflow": "3.1.5",
  "name": "Master Orchestrator - Cron Manual Trigger",
  "type": "n8n-node-patch",
  "purpose": "Start the Master Orchestrator either manually or through a scheduled execution.",

  "nodes": [
    {
      "name": "3.1.5.1 - Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger"
    },
    {
      "name": "3.1.5.1 - Cron Trigger",
      "type": "n8n-nodes-base.scheduleTrigger"
    }
  ],

  "output_contract": {
    "execution_id": "{{$execution.id}}",
    "started_at": "{{$now}}"
  },

  "rules": [
    "Both manual and scheduled execution must enter the same orchestrator path.",
    "Do not hard-code scraper-specific inputs here.",
    "Preserve execution metadata."
  ],

  "integration": {
    "next_step": "3.1.5.2"
  },

  "source_gap": {
    "status": "SCHEDULE_NOT_DEFINED",
    "missing": "Exact cron frequency/time is not specified by the source.",
    "action": "Configure the approved schedule separately."
  }
}

